    "check:logic:2": "node --test exercises/logic/02-condicionais/exercise.test.js",
    "check:logic:3": "node --test exercises/logic/03-loops/exercise.test.js",
    "check:logic:4": "node --test exercises/logic/04-funcoes/exercise.test.js",
    "check:logic:5": "node --test exercises/logic/05-arrays/exercise.test.js",
    "check:logic:6": "node --test exercises/logic/06-algoritmos/exercise.test.js"
  }
}
