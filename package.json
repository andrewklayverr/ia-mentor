{
  "name": "ia-mentor",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "setup:data": "node scripts/init-local.mjs",
    "doctor": "node scripts/doctor.mjs",
